{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bottled Up",
  "version": "1.0.0",
  "identifier": "com.bottled-up.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bottled Up",
        "width": 640,
        "height": 360,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "../public/png/icon32.png",
      "../public/png/icon128.png",
      "../public/png/icon256.png",
      "../public/png/icon512.png"
    ]
  }
}
